{
  "name": "dsh-better-workspaces",
  "description": "Git workspace enhancements for the DeepSeek Harness Web GUI: worktree staging in the hero row, per-session git badges in the sidebar, a diff page in the official right sidebar, paseo-style pull/push/PR actions",
  "version": "0.2.7",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cup113/dsh-better-workspaces.git"
  },
  "bugs": {
    "url": "https://github.com/cup113/dsh-better-workspaces/issues"
  },
  "homepage": "https://github.com/cup113/dsh-better-workspaces#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "git",
    "worktree",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "license": "MIT",
  "files": [
    "cordis.patch.yml",
    "lib",
    "README.md",
    "CONTEXT.md",
    "docs",
    "LICENSE",
    "NOTICE",
    "LICENSES"
  ],
  "scripts": {
    "lint": "eslint .",
    "test:host": "node test/run.js",
    "test:security": "node test/security.mjs",
    "test:mutation": "node test/mutation.mjs",
    "test:client": "node test/client-smoke.mjs && node test/client-react.mjs",
    "test:mount": "node test/mount-check.mjs",
    "test": "npm run test:host && npm run test:security && npm run test:mutation && npm run test:client && npm run test:mount",
    "test:pack": "node test/package.mjs",
    "check": "npm run lint && npm test && npm run test:pack",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "24.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
